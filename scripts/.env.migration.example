# FRAUDE — Supabase taşıma kimlik bilgileri
# ─────────────────────────────────────────────────────────────────────────────
# Bu dosyayı `scripts/.env.migration` adıyla kopyalayıp doldur. O ad
# .gitignore'da — asla commit edilmez.
#
#   cp scripts/.env.migration.example scripts/.env.migration
#
# Sonra: node scripts/run-migration.mjs         (kuru çalışma, hiçbir şey yazmaz)
#        node scripts/run-migration.mjs --apply (gerçekten taşır)
#
# BOŞ BIRAKILAN her satır, o adımın atlanmasına yol açar; script hangi adımı
# neden atladığını söyler. Yani elindekiyle başlayıp sonra tamamlayabilirsin.


# ── 1. YENİ PROJE (zorunlu) ──────────────────────────────────────────────────
# Pano → Project Settings → API Keys
# https://supabase.com/dashboard/project/emrusyelfekcfyisfzzl/settings/api-keys
DST_URL=https://emrusyelfekcfyisfzzl.supabase.co
DST_ANON_KEY=
DST_SERVICE_KEY=

# Pano → Project Settings → Database → Connection string / Reset password
# Şema kurulumu (supabase db push) ve parola taşıması için gerekir.
DST_DB_PASSWORD=


# ── 2. ESKİ PROJE (veri taşımak için zorunlu) ────────────────────────────────
# SRC_SERVICE_KEY zaten scripts/.env içinde var — script oradan da okur,
# burayı boş bırakabilirsin.
SRC_URL=https://frfbmutvkekctpacktlz.supabase.co
SRC_SERVICE_KEY=

# YALNIZCA kullanıcı parolalarını korumak istiyorsan doldur.
# Boşsa: 4 e-posta kullanıcısı yeni projede parola sıfırlamak zorunda kalır.
# Eski pano → Project Settings → Database (gerekirse Reset database password)
SRC_DB_PASSWORD=


# ── 3. EDGE FUNCTION GİZLİ ANAHTARLARI ───────────────────────────────────────
# Brevo panosu → SMTP & API → API Keys (transactional e-posta gönderimi)
BREVO_API_KEY=

# Gönderici. Brevo'da DOĞRULANMIŞ bir adres olmalı.
# Biçim: "Görünen Ad <adres@alanadi>"
MAIL_FROM=

# Kötüye kullanım bildirimlerinin gideceği adres (boşsa MAIL_FROM kullanılır)
ADMIN_EMAIL=

# Site adresi (e-postalardaki bağlantıların kökü)
SITE_URL=https://fraude.intelligentverseconnection.com

# pg_cron ile Edge Function arasındaki paylaşılan gizli.
# Üret:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
CRON_SECRET=

# market-watch'ın haber/KAP önceliklendirmesi için LLM (Qwen/DashScope)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus


# ── 4. AUTH AYARLARI (supabase config push ile kurulur) ──────────────────────
# GitHub OAuth — kullanıcı ihtiyarb21@itu.edu.tr bununla giriyor.
# github.com → Settings → Developer settings → OAuth Apps → uygulaman
# Authorization callback URL'yi ŞUNA çevir:
#   https://emrusyelfekcfyisfzzl.supabase.co/auth/v1/callback
GITHUB_CLIENT_ID=
GITHUB_SECRET=

# Auth e-postaları (kayıt doğrulama, şifre yenileme) için SMTP.
# Brevo → SMTP & API → SMTP sekmesi. Kullanıcı genelde bir numara/e-posta,
# parola ise "SMTP key" değeridir (API anahtarından FARKLI).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
